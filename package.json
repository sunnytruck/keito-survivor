  "private": true,
  "type": "module",
  "description": "岩尊降臨 — ねむれる神の八分間。岩尊けいとの8分間サバイバルアクション。",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
